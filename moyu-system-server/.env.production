# 生产环境模板。请在 .env.production.local 或部署环境中填写真实密钥与地址，
# 不要把线上地址或密钥提交进仓库。
# 已入库的本文件不要填写占位密钥，否则会盖住本地 .env。
# 仓库：https://github.com/advater/moyu-system

NODE_ENV=production

# DATABASE_URL=
# JWT_SECRET=
# SESSION_SECRET=
# REDIS_PASSWORD=
# SMS_CALLBACK_SECRET=

AUTH_CAPTCHA_ENABLED=true
AUTH_REGISTER_ENABLED=false
AUTH_PASSWORD_EXPIRE_ENABLED=true
TENANT_PROBE_CAPTCHA=true
USER_IMPORT_DEFAULT_PASSWORD=ChangeMeOnImport1

SWAGGER_ENABLED=false
