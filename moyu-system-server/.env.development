# 本地开发。密钥请写到 .env.development.local 或本地 .env，不要提交。
# 已入库的本文件不要填写 DATABASE_URL / JWT_SECRET / SESSION_SECRET 等占位密钥，否则会盖住本地 .env。
# 仓库：https://github.com/advater/moyu-system

NODE_ENV=development

# DATABASE_URL=
# JWT_SECRET=
# SESSION_SECRET=
# REDIS_PASSWORD=
# SMS_CALLBACK_SECRET=

AUTH_CAPTCHA_ENABLED=false
AUTH_REGISTER_ENABLED=false
AUTH_PASSWORD_EXPIRE_ENABLED=true
TENANT_PROBE_CAPTCHA=false
USER_IMPORT_DEFAULT_PASSWORD=ChangeMeOnImport1
