// =============================================================
// Prisma Schema — moyu-system-server
// 数据库：MySQL
// 库名：moyu_cloud_db（与 kefu 共用）
// 表前缀：sys_ （@@map 指定）
// 约定：
//   - Prisma 属性名始终为 camelCase（匹配 DO 的字段），
//     通过 @map("xxx_yyy") 映射数据库 snake_case 列。
//   - 审计字段：creator / updater / createTime / updateTime
//               / deleted / deletedAt (+ tenantId for TenantBaseDO)
//   - 软删：deletedAt + deleted （PrismaService.$extends 自动过滤）
//   - 关联：核心从属边使用 Prisma @relation + DB 外键（RESTRICT / SET NULL）
//     刻意不加 FK：parentId=0 树哨兵、审计/API 日志 userId=0、
//     字典 type 软删改写唯一码、租户 contactUser 冷启动顺序
// =============================================================

generator client {
  provider     = "prisma-client"
  charset      = "utf8mb4"
  // Prisma 7 必须显式指定 output；放到 src 下以便随 Nest 编译，并用 @/generated 引用
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────
// 1. 部门（TenantBaseDO）
// ─────────────────────────────────────────────────────────────
model SysDept {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId     String   @map("tenant_id") @db.VarChar(64)
  name         String   @map("name") @db.VarChar(30)
  parentId     Int      @map("parent_id") @db.UnsignedInt @default(0)
  sort         Int      @map("sort") @db.Int @default(0)
  leaderUserId Int?     @map("leader_user_id") @db.UnsignedInt
  phone        String?  @map("phone") @db.VarChar(11)
  email        String?  @map("email") @db.VarChar(50)
  status       Int      @map("status") @db.TinyInt @default(1)

  creator      String?  @map("creator") @db.VarChar(64)
  updater      String?  @map("updater") @db.VarChar(64)
  createTime   DateTime @map("create_time") @default(now())
  updateTime   DateTime @map("update_time") @default(now()) @updatedAt
  deleted      Boolean  @map("deleted") @default(false)
  deletedAt    DateTime? @map("deleted_at")

  /// parentId=0 表示根节点，无对应行，故不做自引用 FK
  users      SysUser[] @relation("UserDept")
  leaderUser SysUser?  @relation("DeptLeader", fields: [leaderUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@map("sys_dept")
  @@index([tenantId])
  @@index([parentId])
  @@index([name])
  @@index([deletedAt])
  @@index([leaderUserId])
}

// ─────────────────────────────────────────────────────────────
// 2. 岗位
// ─────────────────────────────────────────────────────────────
model SysPost {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  name       String   @map("name") @db.VarChar(50)
  code       String   @map("code") @db.VarChar(64)
  sort       Int      @map("sort") @db.Int @default(0)
  status     Int      @map("status") @db.TinyInt @default(1)
  remark     String?  @map("remark") @db.VarChar(500)

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
  createTime DateTime @map("create_time") @default(now())
  updateTime DateTime @map("update_time") @default(now()) @updatedAt
  deleted    Boolean  @map("deleted") @default(false)
  deletedAt  DateTime? @map("deleted_at")

  userPosts SysUserPost[]

  @@unique([tenantId, code], map: "uk_tenant_post_code")
  @@index([tenantId])
  @@map("sys_post")
  @@index([name])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 3. 用户-岗位关联
// ─────────────────────────────────────────────────────────────
model SysUserPost {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  userId     Int      @map("user_id") @db.UnsignedInt
  postId     Int      @map("post_id") @db.UnsignedInt

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
  createTime DateTime @map("create_time") @default(now())
  updateTime DateTime @map("update_time") @default(now()) @updatedAt
  deleted    Boolean  @map("deleted") @default(false)
  deletedAt  DateTime? @map("deleted_at")

  user SysUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  post SysPost @relation(fields: [postId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, userId, postId], map: "uk_tenant_user_post")
  @@index([tenantId])
  @@map("sys_user_post")
  @@index([postId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 4. 字典类型
// ─────────────────────────────────────────────────────────────
model SysDictType {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  name       String   @map("name") @db.VarChar(100)
  type       String   @map("type") @db.VarChar(100)
  status     Int      @map("status") @db.TinyInt @default(1)
  remark     String?  @map("remark") @db.VarChar(500)

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
  createTime DateTime @map("create_time") @default(now())
  updateTime DateTime @map("update_time") @default(now()) @updatedAt
  deleted    Boolean  @map("deleted") @default(false)
  deletedAt  DateTime? @map("deleted_at")

  @@unique([tenantId, type], map: "uk_tenant_dict_type")
  @@index([tenantId])
  @@map("sys_dict_type")
  @@index([name])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 5. 字典数据
// ─────────────────────────────────────────────────────────────
model SysDictData {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  sort       Int      @map("sort") @db.Int @default(0)
  label      String   @map("label") @db.VarChar(100)
  value      String   @map("value") @db.VarChar(100)
  dictType   String   @map("dict_type") @db.VarChar(100)
  status     Int      @map("status") @db.TinyInt @default(1)
  colorType  String?  @map("color_type") @db.VarChar(50)
  cssClass   String?  @map("css_class") @db.VarChar(100)
  remark     String?  @map("remark") @db.VarChar(500)

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
  createTime DateTime @map("create_time") @default(now())
  updateTime DateTime @map("update_time") @default(now()) @updatedAt
  deleted    Boolean  @map("deleted") @default(false)
  deletedAt  DateTime? @map("deleted_at")

  @@unique([tenantId, dictType, value], map: "uk_tenant_dict_type_value")
  @@index([tenantId])
  @@map("sys_dict_data")
  @@index([dictType])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 6. 用户（TenantBaseDO）
// ─────────────────────────────────────────────────────────────
model SysUser {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId    String   @map("tenant_id") @db.VarChar(64)
  username    String   @map("username") @db.VarChar(30)
  password    String   @map("password") @db.VarChar(100)
  remark      String?  @map("remark") @db.VarChar(500)
  deptId      Int?     @map("dept_id") @db.UnsignedInt
  postIds     Json?    @map("post_ids")  // number[] -> JSON array
  status      Int      @map("status") @db.TinyInt @default(1)
  loginIp     String?  @map("login_ip") @db.VarChar(50)
  loginDate   DateTime? @map("login_date")
  /// 最近一次修改密码时间（用于密码过期策略）
  passwordUpdateTime DateTime? @map("password_update_time")
  /// 是否必须修改密码（管理员重置后或策略强制）
  mustChangePassword Boolean @map("must_change_password") @default(false)
  /// 权限版本号：赋权/角色变更时递增，令牌快照与之不一致即立即失效
  permVersion Int      @map("perm_version") @default(0)

  creator     String?  @map("creator") @db.VarChar(64)
  updater     String?  @map("updater") @db.VarChar(64)
  createTime  DateTime @map("create_time") @default(now())
  updateTime  DateTime @map("update_time") @default(now()) @updatedAt
  deleted     Boolean  @map("deleted") @default(false)
  deletedAt   DateTime? @map("deleted_at")

  dept           SysDept?          @relation("UserDept", fields: [deptId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  ledDepts       SysDept[]         @relation("DeptLeader")
  profile        SysUserProfile?
  userRoles      SysUserRole[]
  userPosts      SysUserPost[]
  socialBinds    SysSocialUserBind[]
  notifyMessages SysNotifyMessage[]
  oauth2AccessTokens  SysOAuth2AccessToken[]
  oauth2RefreshTokens SysOAuth2RefreshToken[]
  oauth2Codes         SysOAuth2Code[]
  oauth2Approves      SysOAuth2Approve[]

  @@unique([tenantId, username], map: "uk_tenant_username")
  @@map("sys_user")
  @@index([deptId])
  @@index([deletedAt])
}

/// 用户个人资料（与账号表分离；全部字段可选）
model SysUserProfile {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  userId     Int      @map("user_id") @db.UnsignedInt
  nickname   String?  @map("nickname") @db.VarChar(30)
  email      String?  @map("email") @db.VarChar(50)
  mobile     String?  @map("mobile") @db.VarChar(11)
  sex        Int?     @map("sex") @db.TinyInt
  avatar     String?  @map("avatar") @db.VarChar(255)

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
  createTime DateTime @map("create_time") @default(now())
  updateTime DateTime @map("update_time") @default(now()) @updatedAt
  deleted    Boolean  @map("deleted") @default(false)
  deletedAt  DateTime? @map("deleted_at")

  user SysUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId], map: "uk_user_profile_user")
  @@unique([tenantId, email], map: "uk_tenant_profile_email")
  @@unique([tenantId, mobile], map: "uk_tenant_profile_mobile")
  @@map("sys_user_profile")
  @@index([tenantId])
  @@index([tenantId, nickname])
  @@index([deletedAt])
}

/// 历史密码（改密 / 重置时记录旧密码哈希，最近 N 条不可复用）
model SysUserPasswordHistory {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  userId     Int      @map("user_id") @db.UnsignedInt
  /// 旧密码哈希（bcrypt）
  password   String   @map("password") @db.VarChar(100)

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
  createTime DateTime @map("create_time") @default(now())
  updateTime DateTime @map("update_time") @default(now()) @updatedAt
  deleted    Boolean  @map("deleted") @default(false)
  deletedAt  DateTime? @map("deleted_at")

  @@index([tenantId, userId, createTime])
  @@index([deletedAt])
  @@map("sys_user_password_history")
}

// ─────────────────────────────────────────────────────────────
// 7. 角色（TenantBaseDO）
// ─────────────────────────────────────────────────────────────
model SysRole {
  id               Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId         String   @map("tenant_id") @db.VarChar(64)
  name             String   @map("name") @db.VarChar(30)
  code             String   @map("code") @db.VarChar(100)
  sort             Int      @map("sort") @db.Int @default(0)
  status           Int      @map("status") @db.TinyInt @default(1)
  type             Int      @map("type") @db.TinyInt @default(1)
  remark           String?  @map("remark") @db.VarChar(500)
  dataScope        Int      @map("data_scope") @db.TinyInt @default(1)
  dataScopeDeptIds Json?    @map("data_scope_dept_ids")  // number[] -> JSON

  creator          String?  @map("creator") @db.VarChar(64)
  updater          String?  @map("updater") @db.VarChar(64)
  createTime       DateTime @map("create_time") @default(now())
  updateTime       DateTime @map("update_time") @default(now()) @updatedAt
  deleted          Boolean  @map("deleted") @default(false)
  deletedAt        DateTime? @map("deleted_at")

  userRoles SysUserRole[]
  roleMenus SysRoleMenu[]

  @@unique([tenantId, code], map: "uk_tenant_role_code")
  @@map("sys_role")
  @@index([name])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 8. 菜单
// ─────────────────────────────────────────────────────────────
model SysMenu {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  name          String   @map("name") @db.VarChar(50)
  permission    String?  @map("permission") @db.VarChar(100)
  type          Int      @map("type") @db.TinyInt
  sort          Int      @map("sort") @db.Int @default(0)
  parentId      Int      @map("parent_id") @db.UnsignedInt @default(0)
  path          String?  @map("path") @db.VarChar(200)
  icon          String?  @map("icon") @db.VarChar(100)
  component     String?  @map("component") @db.VarChar(255)
  componentName String?  @map("component_name") @db.VarChar(100)
  status        Int      @map("status") @db.TinyInt @default(1)
  visible       Boolean  @map("visible") @default(true)
  keepAlive     Boolean  @map("keep_alive") @default(false)
  alwaysShow    Boolean  @map("always_show") @default(false)

  creator       String?  @map("creator") @db.VarChar(64)
  updater       String?  @map("updater") @db.VarChar(64)
  createTime    DateTime @map("create_time") @default(now())
  updateTime    DateTime @map("update_time") @default(now()) @updatedAt
  deleted       Boolean  @map("deleted") @default(false)
  deletedAt     DateTime? @map("deleted_at")

  /// parentId=0 为根，不做自引用 FK
  roleMenus SysRoleMenu[]

  @@map("sys_menu")
  @@index([parentId])
  @@index([permission])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 9. 角色-菜单关联（TenantBaseDO）
// ─────────────────────────────────────────────────────────────
model SysRoleMenu {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  roleId     Int      @map("role_id") @db.UnsignedInt
  menuId     Int      @map("menu_id") @db.UnsignedInt

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
  createTime DateTime @map("create_time") @default(now())
  updateTime DateTime @map("update_time") @default(now()) @updatedAt
  deleted    Boolean  @map("deleted") @default(false)
  deletedAt  DateTime? @map("deleted_at")

  role SysRole @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  menu SysMenu @relation(fields: [menuId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, roleId, menuId], map: "uk_tenant_role_menu")
  @@map("sys_role_menu")
  @@index([menuId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 10. 用户-角色关联
// ─────────────────────────────────────────────────────────────
model SysUserRole {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  userId     Int      @map("user_id") @db.UnsignedInt
  roleId     Int      @map("role_id") @db.UnsignedInt

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
  createTime DateTime @map("create_time") @default(now())
  updateTime DateTime @map("update_time") @default(now()) @updatedAt
  deleted    Boolean  @map("deleted") @default(false)
  deletedAt  DateTime? @map("deleted_at")

  user SysUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role SysRole @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, userId, roleId], map: "uk_tenant_user_role")
  @@index([tenantId])
  @@map("sys_user_role")
  @@index([roleId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 11. 通知公告
// ─────────────────────────────────────────────────────────────
model SysNotice {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  title      String   @map("title") @db.VarChar(50)
  type       Int      @map("type") @db.TinyInt
  content    String   @map("content") @db.LongText
  status     Int      @map("status") @db.TinyInt @default(1)
  /// 定向部门（空=全员）
  targetDeptIds Json? @map("target_dept_ids")
  /// 定向角色（空=不按角色过滤；与部门取并集）
  targetRoleIds Json? @map("target_role_ids")
  /// 计划发布时间（空=立即/手动推送）
  publishTime DateTime? @map("publish_time")

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
  createTime DateTime @map("create_time") @default(now())
  updateTime DateTime @map("update_time") @default(now()) @updatedAt
  deleted    Boolean  @map("deleted") @default(false)
  deletedAt  DateTime? @map("deleted_at")

  @@index([tenantId])
  @@map("sys_notice")
  @@index([title])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 12. 站内信模板
// ─────────────────────────────────────────────────────────────
model SysNotifyTemplate {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  name       String   @map("name") @db.VarChar(100)
  code       String   @map("code") @db.VarChar(100)
  type       Int      @map("type") @db.TinyInt
  nickname   String?  @map("nickname") @db.VarChar(50)
  content    String   @map("content") @db.Text
  params     Json?    @map("params")  // string[]
  status     Int      @map("status") @db.TinyInt @default(1)
  remark     String?  @map("remark") @db.VarChar(500)

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
  createTime DateTime @map("create_time") @default(now())
  updateTime DateTime @map("update_time") @default(now()) @updatedAt
  deleted    Boolean  @map("deleted") @default(false)
  deletedAt  DateTime? @map("deleted_at")

  messages SysNotifyMessage[]

  @@unique([tenantId, code], map: "uk_tenant_notify_template_code")
  @@index([tenantId])
  @@map("sys_notify_template")
  @@index([name])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 13. 站内信消息
// ─────────────────────────────────────────────────────────────
model SysNotifyMessage {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  userId            Int      @map("user_id") @db.UnsignedInt
  userType          Int      @map("user_type") @db.TinyInt
  templateId        Int      @map("template_id") @db.UnsignedInt
  templateCode      String   @map("template_code") @db.VarChar(100)
  templateType      Int      @map("template_type") @db.TinyInt
  templateNickname  String?  @map("template_nickname") @db.VarChar(50)
  templateContent   String   @map("template_content") @db.Text
  templateParams    Json?    @map("template_params")  // Record<string, any>
  readStatus        Boolean  @map("read_status") @default(false)

  creator           String?  @map("creator") @db.VarChar(64)
  updater           String?  @map("updater") @db.VarChar(64)
  createTime        DateTime @map("create_time") @default(now())
  updateTime        DateTime @map("update_time") @default(now()) @updatedAt
  deleted           Boolean  @map("deleted") @default(false)
  deletedAt         DateTime? @map("deleted_at")

  user     SysUser          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  template SysNotifyTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@map("sys_notify_message")
  @@index([userId, userType])
  @@index([templateId])
  @@index([readStatus])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 14. 邮件账号
// ─────────────────────────────────────────────────────────────
model SysMailAccount {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  mail            String   @map("mail") @db.VarChar(100)
  username        String   @map("username") @db.VarChar(100)
  password        String   @map("password") @db.VarChar(255)
  host            String   @map("host") @db.VarChar(100)
  port            Int      @map("port") @db.Int
  sslEnable       Boolean  @map("ssl_enable") @default(false)
  starttlsEnable  Boolean  @map("starttls_enable") @default(false)

  creator         String?  @map("creator") @db.VarChar(64)
  updater         String?  @map("updater") @db.VarChar(64)
  createTime      DateTime @map("create_time") @default(now())
  updateTime      DateTime @map("update_time") @default(now()) @updatedAt
  deleted         Boolean  @map("deleted") @default(false)
  deletedAt       DateTime? @map("deleted_at")

  templates SysMailTemplate[]
  logs      SysMailLog[]

  @@index([tenantId])
  @@map("sys_mail_account")
  @@index([mail])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 15. 邮件模板
// ─────────────────────────────────────────────────────────────
model SysMailTemplate {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  name       String   @map("name") @db.VarChar(100)
  code       String   @map("code") @db.VarChar(100)
  accountId  Int      @map("account_id") @db.UnsignedInt
  nickname   String?  @map("nickname") @db.VarChar(50)
  title      String   @map("title") @db.VarChar(200)
  content    String   @map("content") @db.Text
  params     Json?    @map("params")  // string[]
  status     Int      @map("status") @db.TinyInt @default(1)
  remark     String?  @map("remark") @db.VarChar(500)

  creator    String?  @map("creator") @db.VarChar(64)
  updater    String?  @map("updater") @db.VarChar(64)
