  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 28. OAuth2 客户端
// ─────────────────────────────────────────────────────────────
model SysOAuth2Client {
  id                            Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  clientId                      String   @map("client_id") @db.VarChar(128)
  secret                        String   @map("secret") @db.VarChar(255)
  name                          String   @map("name") @db.VarChar(100)
  logo                          String?  @map("logo") @db.VarChar(255)
  description                   String?  @map("description") @db.VarChar(500)
  status                        Int      @map("status") @db.TinyInt @default(1)
  accessTokenValiditySeconds    Int      @map("access_token_validity_seconds") @db.Int @default(7200)
  refreshTokenValiditySeconds   Int      @map("refresh_token_validity_seconds") @db.Int @default(2592000)
  redirectUris                  Json?    @map("redirect_uris")  // string[]
  authorizedGrantTypes          Json?    @map("authorized_grant_types")  // string[]
  scopes                        Json?    @map("scopes")  // string[]
  autoApproveScopes             Json?    @map("auto_approve_scopes")  // string[]
  authorities                   Json?    @map("authorities")  // string[]
  resourceIds                   Json?    @map("resource_ids")  // string[]
  additionalInformation         String?  @map("additional_information") @db.LongText

  creator                       String?  @map("creator") @db.VarChar(64)
  updater                       String?  @map("updater") @db.VarChar(64)
  createTime                    DateTime @map("create_time") @default(now())
  updateTime                    DateTime @map("update_time") @default(now()) @updatedAt
  deleted                       Boolean  @map("deleted") @default(false)
  deletedAt                     DateTime? @map("deleted_at")

  accessTokens  SysOAuth2AccessToken[]
  refreshTokens SysOAuth2RefreshToken[]
  codes         SysOAuth2Code[]
  approves      SysOAuth2Approve[]

  @@unique([clientId], map: "uk_oauth2_client_id")
  @@index([tenantId])
  @@map("sys_oauth2_client")
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 29. OAuth2 访问令牌（TenantBaseDO）
// ─────────────────────────────────────────────────────────────
model SysOAuth2AccessToken {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId     String   @map("tenant_id") @db.VarChar(64)
  accessToken  String   @map("access_token") @db.VarChar(255)
  refreshToken String   @map("refresh_token") @db.VarChar(255)
  userId       Int      @map("user_id") @db.UnsignedInt
  userType     Int      @map("user_type") @db.TinyInt
  userInfo     Json?    @map("user_info")  // Record<string, string>
  clientId     String   @map("client_id") @db.VarChar(128)
  scopes       Json?    @map("scopes")  // string[]
  /// 签发时的用户权限版本快照（与 sys_user.perm_version 逐请求比对）
  permVersion  Int      @map("perm_version") @default(0)
  expiresTime  DateTime @map("expires_time")

  creator      String?  @map("creator") @db.VarChar(64)
  updater      String?  @map("updater") @db.VarChar(64)
  createTime   DateTime @map("create_time") @default(now())
  updateTime   DateTime @map("update_time") @default(now()) @updatedAt
  deleted      Boolean  @map("deleted") @default(false)
  deletedAt    DateTime? @map("deleted_at")

  user   SysUser         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client SysOAuth2Client @relation(fields: [clientId], references: [clientId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([accessToken], map: "uk_oauth2_access_token")
  @@map("sys_oauth2_access_token")
  @@index([refreshToken])
  @@index([userId, userType])
  @@index([clientId])
  @@index([expiresTime])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 30. OAuth2 刷新令牌（TenantBaseDO）
// ─────────────────────────────────────────────────────────────
model SysOAuth2RefreshToken {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId      String   @map("tenant_id") @db.VarChar(64)
  refreshToken  String   @map("refresh_token") @db.VarChar(255)
  userId        Int      @map("user_id") @db.UnsignedInt
  userType      Int      @map("user_type") @db.TinyInt
  clientId      String   @map("client_id") @db.VarChar(128)
  /// 刷新令牌家族编号：同一登录会话的轮换链共用；重放命中时整族吊销
  familyId      String   @map("family_id") @db.VarChar(64)
  scopes        Json?    @map("scopes")  // string[]
  expiresTime   DateTime @map("expires_time")

  creator       String?  @map("creator") @db.VarChar(64)
  updater       String?  @map("updater") @db.VarChar(64)
  createTime    DateTime @map("create_time") @default(now())
  updateTime    DateTime @map("update_time") @default(now()) @updatedAt
  deleted       Boolean  @map("deleted") @default(false)
  deletedAt     DateTime? @map("deleted_at")

  user   SysUser         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client SysOAuth2Client @relation(fields: [clientId], references: [clientId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([refreshToken], map: "uk_oauth2_refresh_token")
  @@map("sys_oauth2_refresh_token")
  @@index([userId, userType])
  @@index([familyId])
  @@index([expiresTime])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 31. OAuth2 授权码
// ─────────────────────────────────────────────────────────────
model SysOAuth2Code {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  code         String   @map("code") @db.VarChar(255)
  userId       Int      @map("user_id") @db.UnsignedInt
  userType     Int      @map("user_type") @db.TinyInt
  clientId     String   @map("client_id") @db.VarChar(128)
  scopes       Json?    @map("scopes")  // string[]
  redirectUri  String   @map("redirect_uri") @db.VarChar(512)
  state        String?  @map("state") @db.VarChar(255)
  expiresTime  DateTime @map("expires_time")

  creator      String?  @map("creator") @db.VarChar(64)
  updater      String?  @map("updater") @db.VarChar(64)
  createTime   DateTime @map("create_time") @default(now())
  updateTime   DateTime @map("update_time") @default(now()) @updatedAt
  deleted      Boolean  @map("deleted") @default(false)
  deletedAt    DateTime? @map("deleted_at")

  user   SysUser         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client SysOAuth2Client @relation(fields: [clientId], references: [clientId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([code], map: "uk_oauth2_code")
  @@index([tenantId])
  @@map("sys_oauth2_code")
  @@index([userId, userType])
  @@index([expiresTime])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 32. OAuth2 授权批准（按 scope 维度）
// ─────────────────────────────────────────────────────────────
model SysOAuth2Approve {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  tenantId   String   @map("tenant_id") @db.VarChar(64)
  userId       Int      @map("user_id") @db.UnsignedInt
  userType     Int      @map("user_type") @db.TinyInt
  clientId     String   @map("client_id") @db.VarChar(128)
  scope        String   @map("scope") @db.VarChar(128)
  approved     Boolean  @map("approved") @default(false)
  expiresTime  DateTime? @map("expires_time")

  creator      String?  @map("creator") @db.VarChar(64)
  updater      String?  @map("updater") @db.VarChar(64)
  createTime   DateTime @map("create_time") @default(now())
  updateTime   DateTime @map("update_time") @default(now()) @updatedAt
  deleted      Boolean  @map("deleted") @default(false)
  deletedAt    DateTime? @map("deleted_at")

  user   SysUser         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  client SysOAuth2Client @relation(fields: [clientId], references: [clientId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, userType, clientId, scope], map: "uk_oauth2_approve_user_client_scope")
  @@index([tenantId])
  @@map("sys_oauth2_approve")
  @@index([expiresTime])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────
// 33. 定时任务（平台级；handler 对应内置执行器名称）
// ─────────────────────────────────────────────────────────────
model SysJob {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  name            String    @map("name") @db.VarChar(64)
  status          Int       @map("status") @db.TinyInt @default(1) // 0 停用 / 1 启用
  handlerName     String    @map("handler_name") @db.VarChar(64)
  handlerParam    String?   @map("handler_param") @db.VarChar(255)
  cronExpression  String    @map("cron_expression") @db.VarChar(64)
  retryCount      Int       @map("retry_count") @db.Int @default(0)
  retryInterval   Int       @map("retry_interval") @db.Int @default(0) // 秒
  monitorTimeout  Int       @map("monitor_timeout") @db.Int @default(0) // 秒，0 不监控
  remark          String?   @map("remark") @db.VarChar(500)

  creator         String?   @map("creator") @db.VarChar(64)
  updater         String?   @map("updater") @db.VarChar(64)
  createTime      DateTime  @map("create_time") @default(now())
  updateTime      DateTime  @map("update_time") @default(now()) @updatedAt
  deleted         Boolean   @map("deleted") @default(false)
  deletedAt       DateTime? @map("deleted_at")

  logs SysJobLog[]

  @@unique([name], map: "uk_job_name")
  @@index([handlerName])
  @@index([status])
  @@index([deletedAt])
  @@map("sys_job")
}

// ─────────────────────────────────────────────────────────────
// 34. 定时任务执行日志（平台级）
// ─────────────────────────────────────────────────────────────
model SysJobLog {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  jobId         Int       @map("job_id") @db.UnsignedInt
  handlerName   String    @map("handler_name") @db.VarChar(64)
  handlerParam  String?   @map("handler_param") @db.VarChar(255)
  executeIndex  Int       @map("execute_index") @db.Int @default(1)
  beginTime     DateTime  @map("begin_time")
  endTime       DateTime? @map("end_time")
  duration      Int?      @map("duration") @db.Int // ms
  status        Int       @map("status") @db.TinyInt @default(0) // 0 成功 / 1 失败
  result        String?   @map("result") @db.VarChar(4000)

  createTime    DateTime  @map("create_time") @default(now())

  job SysJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([jobId])
  @@index([handlerName])
  @@index([beginTime])
  @@index([status])
  @@map("sys_job_log")
}

// ─────────────────────────────────────────────────────────────
// 35. API 访问日志（TenantBaseDO）
// ─────────────────────────────────────────────────────────────
model SysApiAccessLog {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  tenantId        String    @map("tenant_id") @db.VarChar(64)
  traceId         String?   @map("trace_id") @db.VarChar(64)
  userId          Int       @map("user_id") @db.UnsignedInt @default(0)
  userType        Int       @map("user_type") @db.TinyInt @default(0)
  applicationName String    @map("application_name") @db.VarChar(50)
  requestMethod   String    @map("request_method") @db.VarChar(16)
  requestUrl      String    @map("request_url") @db.VarChar(512)
  requestParams   String?   @map("request_params") @db.Text
  responseBody    String?   @map("response_body") @db.Text
  userIp          String?   @map("user_ip") @db.VarChar(50)
  userAgent       String?   @map("user_agent") @db.VarChar(512)
  operateModule   String?   @map("operate_module") @db.VarChar(50)
  operateName     String?   @map("operate_name") @db.VarChar(50)
  operateType     Int       @map("operate_type") @db.TinyInt @default(0)
  beginTime       DateTime  @map("begin_time")
  endTime         DateTime  @map("end_time")
  duration        Int       @map("duration") @db.Int @default(0)
  resultCode      Int       @map("result_code") @db.Int @default(0)
  resultMsg       String?   @map("result_msg") @db.VarChar(512)

  createTime      DateTime  @map("create_time") @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([beginTime])
  @@index([requestUrl])
  @@map("sys_api_access_log")
}

// ─────────────────────────────────────────────────────────────
// 36. API 异常日志（TenantBaseDO）
// ─────────────────────────────────────────────────────────────
model SysApiErrorLog {
  id                         Int       @id @default(autoincrement()) @db.UnsignedInt
  tenantId                   String    @map("tenant_id") @db.VarChar(64)
  traceId                    String?   @map("trace_id") @db.VarChar(64)
  userId                     Int       @map("user_id") @db.UnsignedInt @default(0)
  userType                   Int       @map("user_type") @db.TinyInt @default(0)
  applicationName            String    @map("application_name") @db.VarChar(50)
  requestMethod              String    @map("request_method") @db.VarChar(16)
  requestUrl                 String    @map("request_url") @db.VarChar(512)
  requestParams              String?   @map("request_params") @db.Text
  userIp                     String?   @map("user_ip") @db.VarChar(50)
  userAgent                  String?   @map("user_agent") @db.VarChar(512)
  exceptionTime              DateTime  @map("exception_time")
  exceptionName              String    @map("exception_name") @db.VarChar(128)
  exceptionMessage           String?   @map("exception_message") @db.Text
  exceptionRootCauseMessage  String?   @map("exception_root_cause_message") @db.Text
  exceptionStackTrace        String?   @map("exception_stack_trace") @db.Text
  exceptionClassName         String?   @map("exception_class_name") @db.VarChar(256)
  exceptionFileName          String?   @map("exception_file_name") @db.VarChar(256)
  exceptionMethodName        String?   @map("exception_method_name") @db.VarChar(128)
  exceptionLineNumber        Int?      @map("exception_line_number") @db.Int
  processStatus              Int       @map("process_status") @db.TinyInt @default(0) // 0 未处理 / 1 已处理 / 2 已忽略
  processTime                DateTime? @map("process_time")
  processUserId              Int?      @map("process_user_id") @db.UnsignedInt

  createTime                 DateTime  @map("create_time") @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([exceptionTime])
  @@index([processStatus])
  @@map("sys_api_error_log")
}

// ─────────────────────────────────────────────────────────────
// 37. 业务错误码（TenantBaseDO；平台默认放租户 0）
// ─────────────────────────────────────────────────────────────
model SysErrorCode {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  tenantId        String    @map("tenant_id") @db.VarChar(64)
  type            Int       @map("type") @db.TinyInt @default(2) // 1 自动生成 / 2 手动维护
  applicationName String    @map("application_name") @db.VarChar(50)
  code            Int       @map("code") @db.Int
  message         String    @map("message") @db.VarChar(512)
  memo            String?   @map("memo") @db.VarChar(512)

  creator         String?   @map("creator") @db.VarChar(64)
  updater         String?   @map("updater") @db.VarChar(64)
  createTime      DateTime  @map("create_time") @default(now())
  updateTime      DateTime  @map("update_time") @default(now()) @updatedAt
  deleted         Boolean   @map("deleted") @default(false)
  deletedAt       DateTime? @map("deleted_at")

  @@unique([tenantId, applicationName, code], map: "uk_tenant_app_error_code")
  @@index([tenantId])
  @@index([code])
  @@index([deletedAt])
  @@map("sys_error_code")
}
