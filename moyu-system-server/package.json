  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "node scripts/with-node-env.cjs development nest start --watch",
    "start:debug": "node scripts/with-node-env.cjs development nest start --debug --watch",
    "start:prod": "node scripts/with-node-env.cjs production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "tsx --test test/http-contract/http-contract.test.ts",
    "test:api": "tsx --test test/http-contract/http-contract.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "start:test": "node scripts/with-node-env.cjs test nest start"
  },
