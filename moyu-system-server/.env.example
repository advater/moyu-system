# moyu-system 后端环境变量模板
# 仓库：https://github.com/advater/moyu-system
# 复制为 .env.{development|test|production}.local 后填写真实值，切勿提交 .env 与 *.local

NODE_ENV=development

# 必填：数据库（Prisma 唯一连接来源）
DATABASE_URL=mysql://root:password@127.0.0.1:3306/moyu_cloud_db

# 必填（生产）：JWT / Session（长度必须 ≥ 32；开发环境过短仅告警）
JWT_SECRET=change-me-to-a-long-random-string-32+
SESSION_SECRET=change-me-to-another-long-random-string-32+

# Redis（必须可用；连接失败则拒绝启动）
REDIS_PASSWORD=
# 可选覆盖 host/port（默认读 config.yaml：localhost:6379）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0

# 可选：HTTP 限流（每客户端每接口每分钟次数；默认 200。登录接口仍用 @Throttle 单独收紧）
# THROTTLE_LIMIT=200

# 可选：邮件
EMAIL_USER=
EMAIL_PASS=

# 可选：CSRF
CSRF_SECRET=

# 可选：认证与安全
# 图形验证码（生产默认开启；开发未设置则关闭；可显式覆盖）
AUTH_CAPTCHA_ENABLED=false
# 开放注册（默认关闭）
AUTH_REGISTER_ENABLED=false
# 密码过期校验（默认开启，90 天；改密会刷新 password_update_time）
AUTH_PASSWORD_EXPIRE_ENABLED=true
# 用户导入默认密码（必填，须 ≥12 且含字母数字；导入接口无此变量会拒绝）
USER_IMPORT_DEFAULT_PASSWORD=ChangeMeOnImport1
# 社交登录 redirectUri 白名单（逗号分隔前缀；默认强制；本地可 SOCIAL_REDIRECT_DEV_OPEN=true）
# SOCIAL_REDIRECT_ALLOWLIST=https://admin.example.com/
# SOCIAL_REDIRECT_DEV_OPEN=false
# 匿名租户探测是否要验证码（生产默认 true；开发未设置则 false；可显式覆盖）
TENANT_PROBE_CAPTCHA=false
# 监听地址（容器常用 0.0.0.0；本机可 HOST=127.0.0.1）
# HOST=0.0.0.0
# Swagger：非生产默认开；SWAGGER_ENABLED=false 可关；生产禁止开启
# SWAGGER_ENABLED=true
# 短信回调验签密钥（生产必填；仅请求头 x-sms-callback-token，禁止 Query）
SMS_CALLBACK_SECRET=
# 可选：回调通用 HMAC（x-sms-signature）
# SMS_CALLBACK_HMAC_SECRET=
# 可选：腾讯/阿里厂商签名（x-tc-signature / x-acs-signature）
# SMS_TENCENT_APP_KEY=
# SMS_ALIYUN_ACCESS_KEY_SECRET=
# 邮件/短信异步发送（默认 true；false 则同步）
# MAIL_SEND_ASYNC=true
# SMS_SEND_ASYNC=true
# 登录/操作/API 日志保留天数（定时清理，默认 180）
# LOG_RETENTION_DAYS=180
# API 访问日志（默认开启；false 关闭）
# API_ACCESS_LOG_ENABLED=true
# API_ACCESS_LOG_BODY=false
# API 异常日志（5xx，默认开启）
# API_ERROR_LOG_ENABLED=true
# APPLICATION_NAME=moyu-system-server
# 文件存储：local（默认）| oss
# FILE_STORAGE=local
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_PUBLIC_BASE_URL=https://cdn.example.com
# OSS_PREFIX=uploads/
# IP2REGION_DISABLE_IPV6=true
