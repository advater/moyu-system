# moyu-system 前端环境变量模板
# 仓库：https://github.com/advater/moyu-system
# 本机覆盖请写到 .env.development.local（或对应环境的 *.local），不要提交。

# 页面标题
VITE_APP_TITLE=moyu-system

# 本地开发端口；预览默认见 vite 配置
VITE_PORT=5173

# npm run dev 时是否自动打开浏览器
VITE_OPEN=true

# 租户开关
VITE_APP_TENANT_ENABLE=true

# 验证码开关（需与后端 AUTH_CAPTCHA_ENABLED 一致）
VITE_APP_CAPTCHA_ENABLE=false

# 后端地址（开发时 Vite 把 VITE_API_URL 代理到这里）
VITE_BASE_URL=http://localhost:3000

# 文件上传：server = 走后端，client = 前端直传
VITE_UPLOAD_TYPE=server

# 接口前缀
VITE_API_URL=/admin
# 打包路径与输出目录
VITE_BASE_PATH=/
VITE_OUT_DIR=dist

# 构建优化
VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=true
VITE_COMPRESS=none

# 可选：仅本地调试预填登录，请写在 .env.development.local，不要提交
# VITE_APP_DEFAULT_LOGIN_TENANT=
# VITE_APP_DEFAULT_LOGIN_USERNAME=
# VITE_APP_DEFAULT_LOGIN_PASSWORD=
