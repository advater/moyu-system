# 测试构建：仍指向本机后端，便于联调与预览

NODE_ENV=test
VITE_DEV=false

VITE_APP_TITLE=moyu-system
VITE_PORT=5173
VITE_OPEN=false
VITE_APP_TENANT_ENABLE=true
VITE_APP_CAPTCHA_ENABLE=true

