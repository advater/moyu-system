# 本地开发：对接本机 moyu-system-server
# 覆盖项写到 .env.development.local

NODE_ENV=development
VITE_DEV=true

VITE_APP_TITLE=moyu-system
VITE_PORT=5173
VITE_OPEN=true
VITE_APP_TENANT_ENABLE=true
VITE_APP_CAPTCHA_ENABLE=false

VITE_BASE_URL=http://localhost:3000
VITE_UPLOAD_TYPE=server
VITE_API_URL=/admin
VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=true
VITE_COMPRESS=none
VITE_BASE_PATH=/
VITE_OUT_DIR=dist
