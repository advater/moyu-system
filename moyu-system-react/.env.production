# 生产构建模板：默认仍指向本机，部署时请在 .env.production.local
# 或构建环境中把 VITE_BASE_URL 改成实际 API 地址，不要把线上地址提交进仓库。

NODE_ENV=production
VITE_DEV=false

VITE_APP_TITLE=moyu-system
VITE_PORT=4173
VITE_OPEN=false
VITE_APP_TENANT_ENABLE=true
VITE_APP_CAPTCHA_ENABLE=true

VITE_BASE_URL=http://localhost:3000
VITE_UPLOAD_TYPE=server
VITE_API_URL=/admin
VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_SOURCEMAP=false
VITE_COMPRESS=none
VITE_BASE_PATH=/
VITE_OUT_DIR=dist-prod
